# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na
# Vercel (Settings → Environment Variables). Nenhuma tem prefixo NEXT_PUBLIC_:
# todas ficam só no servidor.

# --- Supabase (Project Settings → API) --------------------------------------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# "service_role" (JWT) ou a nova "secret key" (sb_secret_...). NUNCA exponha.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional — usada só por `npm run db:verificar` para provar que a chave
# pública (anon / sb_publishable_...) não consegue ler nada. O app não usa.
SUPABASE_ANON_KEY=

# --- Acesso do condomínio ----------------------------------------------------
# Código do cartaz/QR Code (comparação sem diferenciar maiúsculas).
CONDO_CODE=VERDE-7K2P
# Troque (ex.: v2) para invalidar todos os acessos sem mudar o código.
CONDO_CODE_VERSION=v1
CONDO_NAME=Condomínio Verde Vida

# --- Administração (síndico) -------------------------------------------------
ADMIN_PASSWORD=troque-por-uma-senha-longa

# --- Job diário de limpeza de fotos (vercel.json → crons) --------------------
# A Vercel envia este valor no header Authorization. Gere um valor aleatório longo.
CRON_SECRET=
